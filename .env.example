# Django Configuration
DJANGO_SECRET_KEY=django-insecure-ap-automation-key-change-in-production-12345
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in Docker / Local)
# Leave DB_ENGINE empty to default to SQLite for quick local runs, or specify postgresql
DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=ap_automation_db
POSTGRES_USER=ap_user
POSTGRES_PASSWORD=ap_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Token Lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# File Storage Security
MAX_UPLOAD_SIZE_MB=15

# CORS Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OCR Provider Configuration (Mocks used by default)
OCR_PROVIDER=mock
# OCR_API_KEY=your_key_here

# Payment Gateway Configuration (Mocks used by default)
PAYMENT_GATEWAY=mock
# PAYMENT_API_KEY=your_key_here
